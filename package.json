{
  "name": "auto-translator",
  "version": "1.0.0",
  "description": "A plug-and-play translation system that adds a floating language switcher widget to any React website.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.modern.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.umd.js",
