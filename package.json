{
  "name": "react-auto-translate-widget",
  "version": "1.0.0",
  "description": "A plug-and-play translation system that adds a floating language switcher widget to any React website.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.modern.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.umd.js",
  "exports": {
    "types": "./dist/index.d.ts",
    "import": "./dist/index.modern.js",
    "require": "./dist/index.cjs"
  },
  "scripts": {
    "build": "microbundle --jsx React.createElement --format modern,cjs,umd",
    "dev": "microbundle watch --jsx React.createElement --format modern,cjs,umd",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "translate",
    "i18n",
    "auto-translate",
    "widget"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "microbundle": "^0.15.1"
  },
  "dependencies": {
    "lucide-react": "^0.263.1"
  }
}
