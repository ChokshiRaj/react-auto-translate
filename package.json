{
  "name": "globe-translate-widget",
  "version": "1.0.0",
  "description": "A plug-and-play translation system that adds a floating language switcher widget to any React website.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
