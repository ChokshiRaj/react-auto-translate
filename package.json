    "i18n",
    "auto-translate",
    "widget",
    "globe-translate-widget"
  ],
  "author": "Raj Chokshi",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChokshiRaj/globe-translate-widget.git"
  },
  "bugs": {
    "url": "https://github.com/ChokshiRaj/globe-translate-widget/issues"
  },
  "homepage": "https://github.com/ChokshiRaj/globe-translate-widget#readme",
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^16.8.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "vite": "^4.3.9"
  },
  "dependencies": {
    "lucide-react": "^0.263.1"
  }
